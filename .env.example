# One token variable per bot. The name is whatever the config's "token_env" says.
# Get a token from @BotFather on Telegram. Never commit the real .env.
MYBOT_TOKEN=123456789:replace-me

# A mysql source reads its connection URL from the env var named by "dsn_env".
MYDATABASEBOT_DB_URL=mysql://cardbot:replace-me@127.0.0.1:3306/mydb

# Where cardbot-monitor sends alerts. Send /help to one of your bots in a
# private chat and it tells you this chat's id.
CARDBOT_ALERT_CHAT_ID=
